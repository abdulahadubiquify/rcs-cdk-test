# Settings for the parking-occupancy AWS Batch prototype.  Load with:  source config.env
# Every AWS resource is created by the CDK stack "rcs-batch-sim"; nothing existing is changed.

export AWS_PROFILE=rcs                 # the profile whose account is 890742591300
export AWS_REGION=eu-north-1
export AWS_DEFAULT_REGION=eu-north-1
export ACCOUNT_ID=890742591300

# Created by the stack (fixed names, so the commands in README.md work as written).
export BUCKET=rcs-batch-sim-890742591300
export JOB_QUEUE=rcs-batch-sim-queue
export JOB_LOG_GROUP=/aws/batch/rcs-batch-sim
export EVENTS_LOG_GROUP=/aws/events/rcs-batch-sim

# Local inputs on this PC (read only).
export SRC=/home/ubiquify/Documents/rcs_code/rcs-workflow-processor
export WEIGHTS=/home/ubiquify/Documents/rcs_weights.pth
# June 24 Fort Wayne flight; every frame carries DJI telemetry (GPS, XMP height, yaw).
export FRAMES_DIR=/home/ubiquify/Documents/workflow_comparison_report/rf_june24/image_cache/daf2688f-251e-4209-8409-75a8724f1117
